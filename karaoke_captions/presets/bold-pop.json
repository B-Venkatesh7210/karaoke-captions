{
  "name": "Bold pop",
  "description": "Short-form style: big caps, yellow pop on the active word.",
  "style": {
    "font_family": "Arial Black",
    "font_size": 88,
    "bold": false,
    "uppercase": true,
    "text_color": "#FFFFFF",
    "highlight_color": "#FACC15",
